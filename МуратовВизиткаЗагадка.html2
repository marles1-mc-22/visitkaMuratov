<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Муратов Мухаммад Равильевич — визитка</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #0a0a0a;
            --surface: #121212;
            --surface-2: #1a1a1a;
            --border: #262626;
            --text: #f5f5f5;
            --muted: #8a8a8a;
            --accent: #d4ff00;
            --accent-soft: rgba(212, 255, 0, 0.12);
            --error: #ff4d4d;
            --success: #4ade80;
        }

        body {
            font-family: 'Inter', -apple-system, 'Segoe UI', Roboto, system-ui, sans-serif;
            min-height: 100vh;
            background: var(--bg);
            background-image:
                radial-gradient(circle at 15% 15%, rgba(212, 255, 0, 0.06), transparent 45%),
                radial-gradient(circle at 85% 85%, rgba(212, 255, 0, 0.04), transparent 45%);
            color: var(--text);
            display: flex; align-items: center; justify-content: center;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 36px 32px;
            width: 100%;
            max-width: 520px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.9);
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            opacity: 0.7;
        }

        /* ======== ЗАГАДКА ======== */
        #quiz-screen {
            display: flex; flex-direction: column;
        }

        .quiz-header {
            display: flex; align-items: center; gap: 12px;
            margin-bottom: 8px;
        }

        .quiz-mark {
            width: 40px; height: 40px;
            border-radius: 10px;
            background: var(--accent-soft);
            border: 1px solid rgba(212, 255, 0, 0.35);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .quiz-header h2 {
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .quiz-subtitle {
            color: var(--muted);
            font-size: 0.88rem;
            margin-bottom: 26px;
            letter-spacing: 0.2px;
        }

        .question {
            font-size: 1.05rem;
            line-height: 1.5;
            color: var(--text);
            padding: 18px 20px;
            background: var(--surface-2);
            border-radius: 12px;
            border-left: 3px solid var(--accent);
            margin-bottom: 22px;
        }

        .question strong { color: var(--accent); font-weight: 700; }

        .options {
            display: flex; flex-direction: column;
            gap: 10px;
            margin-bottom: 16px;
        }

        .option-btn {
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 15px 18px;
            font-size: 1rem;
            color: var(--text);
            font-family: inherit;
            text-align: left;
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex; align-items: center; gap: 14px;
        }

        .option-btn:hover:not(:disabled) {
            border-color: var(--accent);
            background: var(--accent-soft);
            transform: translateX(3px);
        }

        .option-btn:disabled { cursor: not-allowed; }

        .option-letter {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: var(--muted);
            border: 1px solid var(--border);
            width: 30px; height: 30px;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            transition: 0.15s;
        }

        .option-btn:hover:not(:disabled) .option-letter {
            color: var(--accent);
            border-color: var(--accent);
        }

        .option-btn.correct {
            border-color: var(--success);
            background: rgba(74, 222, 128, 0.08);
        }
        .option-btn.correct .option-letter {
            background: var(--success);
            border-color: var(--success);
            color: #0a0a0a;
        }

        .option-btn.wrong {
            border-color: var(--error);
            background: rgba(255, 77, 77, 0.08);
            animation: shake 0.4s ease;
        }
        .option-btn.wrong .option-letter {
            background: var(--error);
            border-color: var(--error);
            color: #0a0a0a;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .feedback {
            min-height: 22px;
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 12px;
            letter-spacing: 0.1px;
        }
        .feedback.success { color: var(--success); }
        .feedback.error { color: var(--error); }

        .retry-btn {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 10px;
            padding: 12px 22px;
            font-size: 0.9rem;
            font-family: inherit;
            font-weight: 600;
            letter-spacing: 0.3px;
            cursor: pointer;
            transition: 0.15s;
            display: none;
            align-self: flex-start;
        }
        .retry-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        /* ======== ВИЗИТКА ======== */
        #card-screen { display: none; flex-direction: column; }

        .avatar-section {
            display: flex; align-items: center;
            gap: 18px;
            margin-bottom: 26px;
            padding-bottom: 24px;
            border-bottom: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .avatar-icon {
            width: 76px; height: 76px;
            border-radius: 14px;
            background: var(--accent-soft);
            border: 1px solid rgba(212, 255, 0, 0.4);
            display: flex; align-items: center; justify-content: center;
            font-size: 2.2rem;
            flex-shrink: 0;
            position: relative;
        }

        .avatar-icon::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 18px;
            border: 1px dashed rgba(212, 255, 0, 0.2);
        }

        .title h1 {
            font-size: 1.45rem;
            font-weight: 800;
            line-height: 1.2;
            letter-spacing: -0.5px;
            margin-bottom: 8px;
        }

        .title p {
            display: flex; align-items: center;
            gap: 8px; flex-wrap: wrap;
            font-size: 0.9rem;
            color: var(--muted);
        }

        .badge {
            background: var(--accent);
            color: #0a0a0a;
            border-radius: 6px;
            padding: 3px 9px;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .info-grid {
            display: flex; flex-direction: column;
            gap: 2px;
            margin-bottom: 24px;
        }

        .info-item {
            display: flex; align-items: center;
            gap: 16px;
            padding: 16px 4px;
            border-bottom: 1px solid var(--border);
            transition: 0.15s;
        }

        .info-item:last-child { border-bottom: none; }

        .info-item:hover {
            padding-left: 10px;
            border-bottom-color: var(--accent);
        }

        .info-icon {
            font-size: 1.25rem;
            width: 32px;
            text-align: center;
            flex-shrink: 0;
            opacity: 0.85;
        }

        .info-text {
            display: flex; flex-direction: column;
            gap: 3px;
            min-width: 0;
        }

        .info-label {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--muted);
            font-weight: 600;
        }

        .info-value {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text);
            letter-spacing: -0.2px;
            word-break: break-word;
        }

        .quote {
            padding: 18px 20px;
            background: var(--surface-2);
            border-left: 3px solid var(--accent);
            border-radius: 10px;
            font-size: 0.95rem;
            font-style: italic;
            line-height: 1.5;
            color: #cfcfcf;
            margin-bottom: 24px;
        }

        .footer {
            display: flex; justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            font-size: 0.78rem;
            color: var(--muted);
            letter-spacing: 0.3px;
        }

        .reset-link {
            color: var(--muted);
            cursor: pointer;
            font-weight: 600;
            transition: 0.15s;
            letter-spacing: 0.3px;
        }
        .reset-link:hover { color: var(--accent); }

        @media (max-width: 480px) {
            .card { padding: 26px 20px; border-radius: 14px; }
            .title h1 { font-size: 1.2rem; }
            .avatar-icon { width: 64px; height: 64px; font-size: 1.8rem; }
            .option-btn { font-size: 0.92rem; padding: 13px 15px; }
        }
    </style>
</head>
<body>

    <!-- ЭКРАН ЗАГАДКИ -->
    <div id="quiz-screen" class="card">
        <div class="quiz-header">
            <div class="quiz-mark">🔒</div>
            <h2>Проверка доступа</h2>
        </div>
        <p class="quiz-subtitle">Ответь правильно, чтобы открыть визитку</p>

        <div class="question" id="question-text"></div>
        <div class="options" id="options-container"></div>

        <div id="feedback" class="feedback"></div>
        <button id="retry-btn" class="retry-btn">Попробовать снова</button>
    </div>

    <!-- ВИЗИТКА -->
    <div id="card-screen" class="card">
        <div class="avatar-section">
            <div class="avatar-icon">📮</div>
            <div class="title">
                <h1 id="profile-name"></h1>
                <p>
                    <span id="profile-role"></span>
                    <span class="badge" id="profile-badge"></span>
                </p>
            </div>
        </div>

        <div class="info-grid" id="info-grid"></div>

        <div class="quote" id="profile-quote"></div>

        <div class="footer">
            <span id="profile-footer"></span>
            <span class="reset-link" id="reset-btn">↻ пройти заново</span>
        </div>
    </div>

    <script>
        /* ============================================================
           1) ДАННЫЕ ВИЗИТКИ
           ============================================================ */
        const PROFILE = {
            name: 'Муратов Мухаммад Равильевич',
            role: 'студент колледжа ВКМиС им. Н. Сердюкова',
            badge: 'почтовая связь',
            quote: '«Дисциплина на тренировке — дисциплина в жизни. Работаю над собой каждый день.»',
            footer: '© 2025 · Группа 12-ПС-26',
            info: [
                { icon: '🎓', label: 'Специальность', value: 'Почтовая связь' },
                { icon: '👥', label: 'Группа',        value: '12-ПС-26' },
                { icon: '🏃', label: 'Увлечение',     value: 'Спорт' }
            ]
        };

        /* ============================================================
           2) ЗАГАДКИ
           ============================================================ */
        const QUIZ_DATA = [
            {
                question: 'Что из перечисленного <strong>НЕ</strong> относится к почтовой связи?',
                options: ['Почтовый индекс', 'Бандероль', 'Телеграмма', 'Заказное письмо'],
                correct: 2,
                success: '✅ Верно! Телеграмма передаётся по проводам, а не почтой.',
                error:   '❌ Не совсем. Телеграмма — это не почтовое отправление.'
            },
            {
                question: 'Сколько цифр в стандартном <strong>российском почтовом индексе</strong>?',
                options: ['4', '5', '6', '7'],
                correct: 2,
                success: '✅ Точно! Российский индекс состоит из 6 цифр.',
                error:   '❌ Мимо. В российском индексе 6 цифр.'
            },
            {
                question: 'Как называется <strong>услуга</strong> отправки письма с уведомлением о вручении?',
                options: ['Простое письмо', 'Заказное письмо', 'Открытка', 'Бандероль'],
                correct: 1,
                success: '✅ Правильно! Заказное письмо вручается под расписку.',
                error:   '❌ Нет. С уведомлением о вручении отправляют заказное письмо.'
            },
            {
                question: 'Какой документ подтверждает оплату почтового отправления?',
                options: ['Квитанция', 'Марка', 'Конверт', 'Индекс'],
                correct: 0,
                success: '✅ Верно! Квитанция — главный документ об оплате.',
                error:   '❌ Не угадал. Подтверждает оплату именно квитанция.'
            },
            {
                question: 'Что изображено на <strong>почтовой марке</strong>?',
                options: ['Только цена', 'Только страна', 'Цена и страна', 'Ничего'],
                correct: 2,
                success: '✅ Точно! На марке — номинал и страна-эмитент.',
                error:   '❌ Не совсем. На марке указывают и цену, и страну.'
            },
            {
                question: 'Какой вид спорта развивает <strong>выносливость</strong> лучше всего?',
                options: ['Шахматы', 'Бег на длинные дистанции', 'Кёрлинг', 'Дартс'],
                correct: 1,
                success: '✅ Верно! Длинные дистанции — классика на выносливость.',
                error:   '❌ Нет. Выносливость лучше всего тренирует бег на длинные дистанции.'
            }
        ];

        /* ============================================================
           3) ЛОГИКА
           ============================================================ */
        const quizScreen = document.getElementById('quiz-screen');
        const cardScreen = document.getElementById('card-screen');
        const questionText = document.getElementById('question-text');
        const optionsContainer = document.getElementById('options-container');
        const feedback = document.getElementById('feedback');
        const retryBtn = document.getElementById('retry-btn');
        const resetBtn = document.getElementById('reset-btn');

        let answered = false;
        let currentQuiz = null;

        function shuffleArray(arr) {
            const a = [...arr];
            for (let i = a.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [a[i], a[j]] = [a[j], a[i]];
            }
            return a;
        }

        function loadRandomQuiz() {
            answered = false;
            feedback.textContent = '';
            feedback.className = 'feedback';
            retryBtn.style.display = 'none';

            const quiz = QUIZ_DATA[Math.floor(Math.random() * QUIZ_DATA.length)];
            currentQuiz = quiz;

            questionText.innerHTML = quiz.question;

            const correctText = quiz.options[quiz.correct];
            const shuffled = shuffleArray(quiz.options);
            const correctIndexNew = shuffled.indexOf(correctText);

            const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
            optionsContainer.innerHTML = '';
            shuffled.forEach((text, idx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.dataset.correct = (idx === correctIndexNew).toString();
                btn.innerHTML = `<span class="option-letter">${letters[idx] || ''}</span><span>${text}</span>`;
                optionsContainer.appendChild(btn);
            });
        }

        optionsContainer.addEventListener('click', (e) => {
            const btn = e.target.closest('.option-btn');
            if (!btn || answered) return;

            answered = true;
            const isCorrect = btn.dataset.correct === 'true';
            const allButtons = optionsContainer.querySelectorAll('.option-btn');
            allButtons.forEach(b => b.disabled = true);

            if (isCorrect) {
                btn.classList.add('correct');
                feedback.textContent = currentQuiz.success;
                feedback.className = 'feedback success';
                setTimeout(() => {
                    quizScreen.style.display = 'none';
                    cardScreen.style.display = 'flex';
                    renderProfile();
                }, 1100);
            } else {
                btn.classList.add('wrong');
                allButtons.forEach(b => {
                    if (b.dataset.correct === 'true') b.classList.add('correct');
                });
                feedback.textContent = currentQuiz.error;
                feedback.className = 'feedback error';
                retryBtn.style.display = 'inline-block';
            }
        });

        retryBtn.addEventListener('click', () => {
            answered = false;
            const allButtons = optionsContainer.querySelectorAll('.option-btn');
            allButtons.forEach(b => {
                b.disabled = false;
                b.classList.remove('correct', 'wrong');
            });
            feedback.textContent = '';
            feedback.className = 'feedback';
            retryBtn.style.display = 'none';
        });

        resetBtn.addEventListener('click', () => {
            cardScreen.style.display = 'none';
            quizScreen.style.display = 'flex';
            loadRandomQuiz();
        });

        function renderProfile() {
            document.getElementById('profile-name').textContent = PROFILE.name;
            document.getElementById('profile-role').textContent = PROFILE.role;
            document.getElementById('profile-badge').textContent = PROFILE.badge;
            document.getElementById('profile-quote').textContent = PROFILE.quote;
            document.getElementById('profile-footer').textContent = PROFILE.footer;

            const grid = document.getElementById('info-grid');
            grid.innerHTML = '';
            PROFILE.info.forEach(item => {
                const div = document.createElement('div');
                div.className = 'info-item';
                div.innerHTML = `
                    <div class="info-icon">${item.icon}</div>
                    <div class="info-text">
                        <span class="info-label">${item.label}</span>
                        <span class="info-value">${item.value}</span>
                    </div>
                `;
                grid.appendChild(div);
            });
        }

        loadRandomQuiz();
    </script>
</body>
</html>